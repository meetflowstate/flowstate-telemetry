{
  "hooks": {
    "post_cascade_response": [
      {
        "command": "$HOME/.windsurf/hooks/flowstate.sh post_cascade_response",
        "show_output": false
      }
    ],
    "post_write_code": [
      {
        "command": "$HOME/.windsurf/hooks/flowstate.sh post_write_code",
        "show_output": false
      }
    ],
    "pre_run_command": [
      {
        "command": "/usr/local/bin/guard"
      }
    ],
    "pre_user_prompt": [
      {
        "command": "$HOME/.windsurf/hooks/flowstate.sh pre_user_prompt",
        "show_output": false
      }
    ]
  }
}
